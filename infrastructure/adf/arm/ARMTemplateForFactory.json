{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-arlp-dev-diego01"
        },
        "ls_key_vault_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://kv-arlp-dev-diego01.vault.azure.net/"
        },
        "ls_sqlserver_local_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "localhost,1433"
        },
        "ls_sqlserver_local_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "TechRetail_OLTP"
        },
        "ls_sqlserver_local_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "retail_reader"
        },
        "ls_adls_gen2_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://starlpdevdiego01.dfs.core.windows.net/"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/shir-arlp-dev-local')]",
            "type": "Microsoft.DataFactory/factories/integrationRuntimes",
            "apiVersion": "2018-06-01",
            "properties": {
                "type": "SelfHosted",
                "description": "Acceso a SQL Server local para la ingesta de TechRetail_OLTP.",
                "typeProperties": {}
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_key_vault')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureKeyVault",
                "typeProperties": {
                    "baseUrl": "[parameters('ls_key_vault_properties_typeProperties_baseUrl')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_sqlserver_local')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "SqlServer",
                "typeProperties": {
                    "server": "[parameters('ls_sqlserver_local_properties_typeProperties_server')]",
                    "database": "[parameters('ls_sqlserver_local_properties_typeProperties_database')]",
                    "encrypt": "mandatory",
                    "trustServerCertificate": true,
                    "authenticationType": "SQL",
                    "userName": "[parameters('ls_sqlserver_local_properties_typeProperties_userName')]",
                    "password": {
                        "type": "AzureKeyVaultSecret",
                        "store": {
                            "referenceName": "ls_key_vault",
                            "type": "LinkedServiceReference"
                        },
                        "secretName": "sqlserver-retail-reader-password"
                    }
                },
                "connectVia": {
                    "referenceName": "shir-arlp-dev-local",
                    "type": "IntegrationRuntimeReference"
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/integrationRuntimes/shir-arlp-dev-local')]",
                "[concat(variables('factoryId'), '/linkedServices/ls_key_vault')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_adls_gen2')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('ls_adls_gen2_properties_typeProperties_url')]"
                },
                "connectVia": {
                    "referenceName": "shir-arlp-dev-local",
                    "type": "IntegrationRuntimeReference"
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/integrationRuntimes/shir-arlp-dev-local')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_sqlserver_categories')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_sqlserver_local",
                    "type": "LinkedServiceReference"
                },
                "annotations": [],
                "type": "SqlServerTable",
                "schema": [
                    {
                        "name": "category_id",
                        "type": "int",
                        "precision": 10
                    },
                    {
                        "name": "category_name",
                        "type": "nvarchar"
                    },
                    {
                        "name": "created_at",
                        "type": "datetime2",
                        "scale": 3
                    },
                    {
                        "name": "updated_at",
                        "type": "datetime2",
                        "scale": 3
                    }
                ],
                "typeProperties": {
                    "schema": "dbo",
                    "table": "categories"
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_sqlserver_local')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_adls_categories_smoke_test')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_adls_gen2",
                    "type": "LinkedServiceReference"
                },
                "annotations": [],
                "type": "DelimitedText",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": "categories.csv",
                        "folderPath": "connectivity/sqlserver",
                        "fileSystem": "operations"
                    },
                    "columnDelimiter": ",",
                    "encodingName": "UTF-8",
                    "escapeChar": "\\",
                    "firstRowAsHeader": true,
                    "quoteChar": "\""
                },
                "schema": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls_gen2')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_connectivity_sqlserver_adls')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "copy_categories_smoke_test",
                        "type": "Copy",
                        "dependsOn": [],
                        "policy": {
                            "timeout": "0.00:10:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "SqlServerSource",
                                "queryTimeout": "02:00:00",
                                "partitionOption": "None"
                            },
                            "sink": {
                                "type": "DelimitedTextSink",
                                "storeSettings": {
                                    "type": "AzureBlobFSWriteSettings"
                                },
                                "formatSettings": {
                                    "type": "DelimitedTextWriteSettings",
                                    "quoteAllText": true,
                                    "fileExtension": ".txt"
                                }
                            },
                            "enableStaging": false,
                            "translator": {
                                "type": "TabularTranslator",
                                "typeConversion": true,
                                "typeConversionSettings": {
                                    "allowDataTruncation": true,
                                    "treatBooleanAsNumber": false
                                }
                            }
                        },
                        "inputs": [
                            {
                                "referenceName": "ds_sqlserver_categories",
                                "type": "DatasetReference",
                                "parameters": {}
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "ds_adls_categories_smoke_test",
                                "type": "DatasetReference",
                                "parameters": {}
                            }
                        ]
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "annotations": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_sqlserver_categories')]",
                "[concat(variables('factoryId'), '/datasets/ds_adls_categories_smoke_test')]"
            ]
        }
    ]
}